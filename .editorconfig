root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,xaml,resw,resx,props,targets,slnx,appxmanifest,manifest,pubxml,ps1}]
# Make UTF-8 explicit to Visual Studio even when a file contains only ASCII.
charset = utf-8-bom

[*.cs]
indent_style = space
indent_size = 4

[*.{xaml,csproj,props,slnx,json,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
