<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="MarkdownMkII.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MarkdownMkII.ViewModels" xmlns:views="using:MarkdownMkII.Views" Title="Markdown MkII">
    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" SizeChanged="OnShellSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border x:Name="SolidBackgroundLayer" Grid.RowSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" IsHitTestVisible="False" />
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <TextBlock x:Name="TitleBarText" Text="Markdown MkII" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="22,0,160,0" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="WorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NotesColumn" Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid x:Name="NotesSidebar">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="52" /></Grid.RowDefinitions>
                <views:NoteBrowser x:Name="Browser" Margin="12,14,12,8"/>
                <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SettingsButton" x:Uid="WorkspaceSettings" Style="{StaticResource RoundChromeButtonStyle}" Click="OnSettingsClick"><FontIcon Glyph="&#xE713;" FontSize="17" /></Button>
                        <Button x:Uid="WorkspaceInfo" Style="{StaticResource RoundChromeButtonStyle}" Click="OnInfoClick"><FontIcon Glyph="&#xE946;" FontSize="17" /></Button>
                    </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="WorkspaceSurface" Grid.Column="1" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="32" Margin="0,0,1,1">
                <Grid>
                    <TextBlock x:Name="EmptyWorkspace" x:Uid="WorkspaceEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="32" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Frame x:Name="ContentFrame" />
                    <Button x:Name="BackToEditorButton" x:Uid="WorkspaceBack" Style="{StaticResource ChromeButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" Visibility="Collapsed" Click="OnBackToEditor"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
