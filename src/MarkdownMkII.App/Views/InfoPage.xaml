<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MarkdownMkII.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style TargetType="controls:SettingsCard" BasedOn="{StaticResource SettingsRowStyle}" />
        <Style TargetType="controls:SettingsExpander" BasedOn="{StaticResource SettingsGroupStyle}" />
    </Page.Resources>
    <Grid MaxWidth="1064" Padding="28,52,28,24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Spacing="6">
            <StackPanel Margin="32,0,16,12" Spacing="4">
                <TextBlock x:Uid="InfoTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="InfoBlurb" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <controls:SettingsCard x:Uid="InfoAppCard" Header="Markdown MkII">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="InfoProjectCard" Description="{x:Bind ViewModel.ProjectSummary}">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE77B;" /></controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="InfoGitHub" Command="{x:Bind ViewModel.OpenRepositoryCommand}" />
                    <Button x:Uid="InfoLicense" Command="{x:Bind ViewModel.OpenLicenseCommand}" />
                </StackPanel>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="InfoVersionCard">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></controls:SettingsCard.HeaderIcon>
                <TextBlock Text="{x:Bind ViewModel.VersionSummary}" FontWeight="SemiBold" />
            </controls:SettingsCard>
            <controls:SettingsExpander x:Uid="InfoUpdatesCard" Description="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}" IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE895;" /></controls:SettingsExpander.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="InfoCheckUpdates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" IsEnabled="{x:Bind ViewModel.CanCheckForUpdates, Mode=OneWay}" />
                    <Button x:Uid="InfoRestartUpdate" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RestartToUpdateCommand}" Visibility="{x:Bind ViewModel.IsUpdateReady, Mode=OneWay}" />
                </StackPanel>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="InfoAutoUpdates" IsEnabled="{x:Bind ViewModel.UpdatesSupported}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.CheckForUpdatesAtStartup, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsCard x:Uid="InfoReportCard">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xEBE8;" /></controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="InfoCopyDiagnostics" Command="{x:Bind ViewModel.CopyDiagnosticsCommand}" />
                    <Button x:Uid="InfoReportIssue" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ReportIssueCommand}" />
                </StackPanel>
            </controls:SettingsCard>
            <InfoBar x:Uid="InfoDiagnosticsCopied" IsOpen="{x:Bind ViewModel.DiagnosticsCopied, Mode=TwoWay}" Severity="Success" />

            <controls:SettingsExpander x:Uid="InfoComponents">
                <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE950;" /></controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Windows" Description="{x:Bind ViewModel.Platform}" />
                    <controls:SettingsCard Header=".NET" Description="{x:Bind ViewModel.Runtime}" />
                    <controls:SettingsCard Header="WinUI 3" Description="{x:Bind ViewModel.WinUIVersion}" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsExpander x:Uid="InfoDataPaths" IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE838;" /></controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="InfoDatabasePath">
                        <controls:SettingsCard.Description><TextBlock Text="{x:Bind ViewModel.DatabasePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="InfoCopyPath" Tag="{x:Bind ViewModel.DatabasePath}" Click="OnCopyPath" />
                            <Button x:Uid="InfoOpenPath" Tag="{x:Bind ViewModel.DatabasePath}" Click="OnOpenPath" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="InfoSettingsPath">
                        <controls:SettingsCard.Description><TextBlock Text="{x:Bind ViewModel.SettingsPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="InfoCopyPath" Tag="{x:Bind ViewModel.SettingsPath}" Click="OnCopyPath" />
                            <Button x:Uid="InfoOpenPath" Tag="{x:Bind ViewModel.SettingsPath}" Click="OnOpenPath" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="InfoLogPath">
                        <controls:SettingsCard.Description><TextBlock Text="{x:Bind ViewModel.LogPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></controls:SettingsCard.Description>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="InfoCopyPath" Tag="{x:Bind ViewModel.LogPath}" Click="OnCopyPath" />
                            <Button x:Uid="InfoOpenLog" Command="{x:Bind ViewModel.OpenLogCommand}" />
                        </StackPanel>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
