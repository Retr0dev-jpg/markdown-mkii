<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="MarkdownMkII.Views.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style TargetType="controls:SettingsCard" BasedOn="{StaticResource SettingsRowStyle}" />
        <Style TargetType="controls:SettingsExpander" BasedOn="{StaticResource SettingsGroupStyle}" />
    </Page.Resources>
    <Grid MaxWidth="1064" Padding="28,52,28,24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch" Spacing="6">
            <StackPanel Margin="32,0,16,12" Spacing="4">
                <TextBlock x:Uid="InfoTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="InfoBlurb" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <controls:SettingsCard x:Uid="InfoAppCard" Header="Markdown MkII">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8A5;" /></controls:SettingsCard.HeaderIcon>
            </controls:SettingsCard>
            <controls:SettingsCard x:Uid="InfoVersionCard">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE946;" /></controls:SettingsCard.HeaderIcon>
                <TextBlock Text="{x:Bind ViewModel.VersionSummary}" FontWeight="SemiBold" />
            </controls:SettingsCard>
            <controls:SettingsExpander x:Uid="InfoComponents">
                <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE950;" /></controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard Header="Windows" Description="{x:Bind ViewModel.Platform}" />
                    <controls:SettingsCard Header=".NET" Description="{x:Bind ViewModel.Runtime}" />
                    <controls:SettingsCard Header="WinUI 3" Description="{x:Bind ViewModel.WinUIVersion}" />
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <controls:SettingsExpander x:Uid="InfoDataPaths" IsExpanded="False">
                <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE838;" /></controls:SettingsExpander.HeaderIcon>
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="InfoDatabasePath" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8"><TextBlock Text="{x:Bind ViewModel.DatabasePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="InfoCopyPath" Tag="{x:Bind ViewModel.DatabasePath}" Click="OnCopyPath"/><Button x:Uid="InfoOpenPath" Tag="{x:Bind ViewModel.DatabasePath}" Click="OnOpenPath"/></StackPanel></StackPanel>
                        
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="InfoSettingsPath" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8"><TextBlock Text="{x:Bind ViewModel.SettingsPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="InfoCopyPath" Tag="{x:Bind ViewModel.SettingsPath}" Click="OnCopyPath"/><Button x:Uid="InfoOpenPath" Tag="{x:Bind ViewModel.SettingsPath}" Click="OnOpenPath"/></StackPanel></StackPanel>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="InfoLogPath" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.LogPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="InfoCopyPath" Tag="{x:Bind ViewModel.LogPath}" Click="OnCopyPath"/><Button x:Uid="InfoOpenLog" Command="{x:Bind ViewModel.OpenLogCommand}"/></StackPanel>
                        </StackPanel>
                    </controls:SettingsCard>
            <controls:SettingsCard x:Uid="InfoDiagnostics">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C8;" /></controls:SettingsCard.HeaderIcon>
                <Button x:Uid="InfoCopyDiagnostics" Command="{x:Bind ViewModel.CopyDiagnosticsCommand}" />
            </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
            <InfoBar x:Uid="InfoDiagnosticsCopied" IsOpen="{x:Bind ViewModel.DiagnosticsCopied, Mode=TwoWay}" Severity="Success" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
